<Window x:Class="KmlScopedEditor.Views.LineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KmlScopedEditor.Views"
        Title="Line Editor"
        Width="1200"
        Height="820"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#F3F4F6"
                BorderBrush="#D7DAE0"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel>
                <WrapPanel>
                    <ToggleButton x:Name="SelectToolButton"
                                  Content="Select"
                                  Width="86"
                                  Height="32"
                                  Margin="0,0,6,0"
                                  Click="OnSelectToolClick" />
                    <ToggleButton x:Name="CutToolButton"
                                  Content="Cut"
                                  Width="86"
                                  Height="32"
                                  Margin="0,0,12,0"
                                  Click="OnCutToolClick" />

                    <Button Content="Fit to View"
                            Width="100"
                            Height="32"
                            Margin="0,0,12,0"
                            Click="OnFitViewClick" />

                    <Button Content="Undo"
                            Width="80"
                            Height="32"
                            Margin="0,0,6,0"
                            Click="OnUndoClick" />
                    <Button Content="Clear Selection"
                            Width="115"
                            Height="32"
                            Margin="0,0,6,0"
                            Click="OnClearSelectionClick" />
                    <Button Content="Invert Selection"
                            Width="115"
                            Height="32"
                            Margin="0,0,6,0"
                            Click="OnInvertSelectionClick" />
                    <Button Content="Delete Selected"
                            Width="120"
                            Height="32"
                            Click="OnDeleteSelectedClick" />
                </WrapPanel>

                <TextBlock x:Name="InstructionText"
                           Margin="0,8,0,0"
                           Foreground="#4B5563"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#F8F9FA"
                BorderBrush="#D7DAE0"
                BorderThickness="0,1,0,0"
                Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Content="Cancel"
                            Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="OnCancelClick" />
                    <Button Content="Apply &amp; Close"
                            Width="120"
                            Height="32"
                            Click="OnApplyClick" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Changes are made on a working copy. Cancel closes the editor without changing the loaded KML/KMZ."
                               Foreground="#6B7280"
                               FontSize="11"
                               Margin="0,3,12,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Margin="10"
                BorderBrush="#C8CCD2"
                BorderThickness="1"
                Background="White">
            <views:LineEditorSurface x:Name="EditorSurface" />
        </Border>
    </DockPanel>
</Window>
