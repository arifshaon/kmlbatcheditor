<Window x:Class="KmlScopedEditor.Views.LineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KmlScopedEditor.Views"
        Title="Line Editor"
        Width="1280"
        Height="840"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#F3F4F6"
                BorderBrush="#D7DAE0"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel>
                <WrapPanel>
                    <ToggleButton x:Name="SelectToolButton"
                                  Content="Select"
                                  Width="82"
                                  Height="32"
                                  Margin="0,0,6,6"
                                  ToolTip="Select lines (V)"
                                  Click="OnSelectToolClick" />
                    <ToggleButton x:Name="CutToolButton"
                                  Content="Cut"
                                  Width="72"
                                  Height="32"
                                  Margin="0,0,6,6"
                                  ToolTip="Draw a cut line (C)"
                                  Click="OnCutToolClick" />
                    <ToggleButton x:Name="PanToolButton"
                                  Content="Hand"
                                  Width="72"
                                  Height="32"
                                  Margin="0,0,14,6"
                                  ToolTip="Pan the view (H). Space+drag and middle-drag also pan."
                                  Click="OnPanToolClick" />

                    <Button Content="Undo"
                            Width="72"
                            Height="32"
                            Margin="0,0,6,6"
                            ToolTip="Undo last cut or deletion (Ctrl+Z)"
                            Click="OnUndoClick" />
                    <Button Content="Fit"
                            Width="62"
                            Height="32"
                            Margin="0,0,6,6"
                            ToolTip="Fit all lines and guides to the view (F)"
                            Click="OnFitViewClick" />
                    <Button Content="Zoom Selection"
                            Width="112"
                            Height="32"
                            Margin="0,0,6,6"
                            ToolTip="Zoom to currently selected lines"
                            Click="OnZoomSelectionClick" />
                    <Button Content="+"
                            Width="34"
                            Height="32"
                            Margin="0,0,4,6"
                            ToolTip="Zoom in (+)"
                            Click="OnZoomInClick" />
                    <Button Content="-"
                            Width="34"
                            Height="32"
                            Margin="0,0,12,6"
                            ToolTip="Zoom out (-)"
                            Click="OnZoomOutClick" />
                </WrapPanel>

                <WrapPanel x:Name="SelectActionsPanel">
                    <TextBlock Text="Selection:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,6" />
                    <Button Content="Clear"
                            Width="70"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnClearSelectionClick" />
                    <Button Content="Invert"
                            Width="70"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnInvertSelectionClick" />
                    <Button Content="Cut Selected..."
                            Width="115"
                            Height="30"
                            Margin="0,0,6,6"
                            ToolTip="Keep the current selection as the cut target, then draw a cut line across it"
                            Click="OnCutSelectedClick" />
                    <Button Content="Delete Selected"
                            Width="115"
                            Height="30"
                            Margin="0,0,0,6"
                            ToolTip="Delete highlighted lines (Delete)"
                            Click="OnDeleteSelectedClick" />
                </WrapPanel>

                <WrapPanel x:Name="CutActionsPanel"
                           Visibility="Collapsed">
                    <TextBlock Text="Cut guides:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,6" />
                    <Button Content="Import Cut Lines..."
                            Width="125"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnImportCutLinesClick" />
                    <Button Content="Use Selected as Cutline"
                            Width="165"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnUseSelectedAsCutlineClick" />
                    <Button Content="Apply Imported Guide"
                            Width="145"
                            Height="30"
                            Margin="0,0,6,6"
                            ToolTip="Apply imported/existing guide lines. Hand-drawn cuts apply when you finish drawing."
                            Click="OnApplyCutLinesClick" />
                    <Button Content="Clear Guides"
                            Width="100"
                            Height="30"
                            Margin="0,0,0,6"
                            Click="OnClearGuidesClick" />
                </WrapPanel>

                <TextBlock x:Name="ScopeText"
                           Margin="0,2,0,0"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="InstructionText"
                           Margin="0,3,0,0"
                           Foreground="#4B5563"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#F8F9FA"
                BorderBrush="#D7DAE0"
                BorderThickness="0,1,0,0"
                Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Content="Cancel"
                            Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="OnCancelClick" />
                    <Button Content="Apply to Document &amp; Close"
                            Width="180"
                            Height="32"
                            ToolTip="Commits line edits to the application's working document. You will then be asked whether to save an edited KML/KMZ file."
                            Click="OnApplyClick" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Selection is temporary targeting and is not saved in KML/KMZ. To change geometry, use Cut Selected... or Delete Selected. Applied cuts/deletions are undoable."
                               Foreground="#6B7280"
                               FontSize="11"
                               Margin="0,3,12,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Margin="10"
                BorderBrush="#C8CCD2"
                BorderThickness="1"
                Background="White">
            <Grid>
                <views:LineEditorSurface x:Name="EditorSurface" />

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="8,6"
                        Background="#EFFFFFFF"
                        BorderBrush="#C8CCD2"
                        BorderThickness="1"
                        CornerRadius="3"
                        IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="MapScopeText"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"
                                   MaxWidth="520" />
                        <TextBlock x:Name="ToolHintText"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   MaxWidth="600" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>
