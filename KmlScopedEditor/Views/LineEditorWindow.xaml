<Window x:Class="KmlScopedEditor.Views.LineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KmlScopedEditor.Views"
        Title="Line Editor"
        Width="1280"
        Height="840"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#F3F4F6"
                BorderBrush="#D7DAE0"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel>
                <WrapPanel>
                    <ToggleButton Focusable="False" x:Name="SelectToolButton"
                                  Content="Select"
                                  Width="82"
                                  Height="32"
                                  Margin="0,0,6,6"
                                  ToolTip="Select lines (V)"
                                  Click="OnSelectToolClick" />
                    <ToggleButton Focusable="False" x:Name="SplitToolButton"
                                  Content="Split"
                                  Width="72"
                                  Height="32"
                                  Margin="0,0,6,6"
                                  ToolTip="Draw a split line (S)"
                                  Click="OnSplitToolClick" />
                    <ToggleButton Focusable="False" x:Name="PanToolButton"
                                  Content="Hand"
                                  Width="72"
                                  Height="32"
                                  Margin="0,0,14,6"
                                  ToolTip="Pan the view (H). Right-drag pans from any tool; Space+drag and middle-drag also pan."
                                  Click="OnPanToolClick" />

                    <Button Focusable="False" Content="Undo"
                            Width="72"
                            Height="32"
                            Margin="0,0,6,6"
                            ToolTip="Undo last split or deletion (Ctrl+Z)"
                            Click="OnUndoClick" />
                    <Button Focusable="False" Content="Fit"
                            Width="62"
                            Height="32"
                            Margin="0,0,6,6"
                            ToolTip="Fit all lines and split lines to the view (F)"
                            Click="OnFitViewClick" />
                    <Button Focusable="False" Content="Zoom Selection"
                            Width="112"
                            Height="32"
                            Margin="0,0,6,6"
                            ToolTip="Zoom to currently selected lines"
                            Click="OnZoomSelectionClick" />
                    <Button Focusable="False" Content="+"
                            Width="34"
                            Height="32"
                            Margin="0,0,4,6"
                            ToolTip="Zoom in (+)"
                            Click="OnZoomInClick" />
                    <Button Focusable="False" Content="-"
                            Width="34"
                            Height="32"
                            Margin="0,0,12,6"
                            ToolTip="Zoom out (-)"
                            Click="OnZoomOutClick" />
                </WrapPanel>

                <WrapPanel x:Name="SelectActionsPanel">
                    <TextBlock Text="Selection:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,6" />
                    <Button Focusable="False" Content="Clear"
                            Width="70"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnClearSelectionClick" />
                    <Button Focusable="False" Content="Invert"
                            Width="70"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnInvertSelectionClick" />
                    <Button Focusable="False" Content="Split Selected Lines..."
                            Width="115"
                            Height="30"
                            Margin="0,0,6,6"
                            ToolTip="Keep the current selection as the split target, then draw a split line across it"
                            Click="OnSplitSelectedClick" />
                    <Button Focusable="False" Content="Delete Selected"
                            Width="115"
                            Height="30"
                            Margin="0,0,0,6"
                            ToolTip="Delete highlighted lines (Delete)"
                            Click="OnDeleteSelectedClick" />
                </WrapPanel>

                <WrapPanel x:Name="SplitActionsPanel"
                           Visibility="Collapsed">
                    <TextBlock Text="Split lines:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,6" />
                    <Button Focusable="False" Content="Import Split Line..."
                            Width="125"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnImportSplitLineClick" />
                    <Button Focusable="False" x:Name="EditImportedLineButton"
                            Content="Edit Imported Line"
                            Width="130"
                            Height="30"
                            Margin="0,0,6,6"
                            ToolTip="Show draggable vertex handles for the pending imported split line"
                            Click="OnEditImportedLineClick" />
                    <Button Focusable="False" Content="Use Selected as Split Line"
                            Width="165"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnUseSelectedAsSplitLineClick" />
                    <Button Focusable="False" Content="Split with Imported Line"
                            Width="145"
                            Height="30"
                            Margin="0,0,6,6"
                            ToolTip="Use the imported/existing split line to split the current target. Hand-drawn split lines apply when you finish drawing."
                            Click="OnApplyImportedSplitLineClick" />
                    <Button Focusable="False" Content="Clear Split Lines"
                            Width="100"
                            Height="30"
                            Margin="0,0,0,6"
                            Click="OnClearSplitLinesClick" />
                </WrapPanel>

                <TextBlock x:Name="ScopeText"
                           Margin="0,2,0,0"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="InstructionText"
                           Margin="0,3,0,0"
                           Foreground="#4B5563"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#F8F9FA"
                BorderBrush="#D7DAE0"
                BorderThickness="0,1,0,0"
                Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Focusable="False" Content="Cancel"
                            Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="OnCancelClick" />
                    <Button Focusable="False" Content="Apply &amp; Close"
                            Width="120"
                            Height="32"
                            ToolTip="Keeps the line edits in the currently loaded document. Use Save As in the main window whenever you want to write them to disk."
                            Click="OnApplyClick" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Selection is temporary targeting and is not saved in KML/KMZ. To change geometry, use Split Selected Lines... or Delete Selected. Applied splits/deletions are undoable."
                               Foreground="#6B7280"
                               FontSize="11"
                               Margin="0,3,12,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Margin="10"
                BorderBrush="#C8CCD2"
                BorderThickness="1"
                Background="White">
            <Grid>
                <views:LineEditorSurface x:Name="EditorSurface" />

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="8,6"
                        Background="#EFFFFFFF"
                        BorderBrush="#C8CCD2"
                        BorderThickness="1"
                        CornerRadius="3"
                        IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="MapScopeText"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"
                                   MaxWidth="520" />
                        <TextBlock x:Name="ToolHintText"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   MaxWidth="600" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>
