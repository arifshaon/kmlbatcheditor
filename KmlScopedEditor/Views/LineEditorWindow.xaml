<Window x:Class="KmlScopedEditor.Views.LineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KmlScopedEditor.Views"
        Title="Line Editor — Simple KML Editor"
        Icon="/KmlScopedEditor;component/Assets/simple_kml_editor.ico"
        Width="1380"
        Height="860"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="StepButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D3DAE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#4A5568" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#EEF4FF" />
                    <Setter Property="BorderBrush" Value="#2F6FCC" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Foreground" Value="#174EA6" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <ToggleButton Focusable="False"
                                      x:Name="Step1Button"
                                      Style="{StaticResource StepButtonStyle}"
                                      Click="OnStep1Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="#22A06B"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="1"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Optional cleanup"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Delete whole lines before splitting"
                                               FontSize="10"
                                               Foreground="#7A8494" />
                                </StackPanel>
                            </StackPanel>
                        </ToggleButton>

                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <ToggleButton Focusable="False"
                                      x:Name="Step2Button"
                                      Style="{StaticResource StepButtonStyle}"
                                      Click="OnStep2Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="#2F6FCC"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="2"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Split"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Import or draw a split line"
                                               FontSize="10"
                                               Foreground="#7A8494" />
                                </StackPanel>
                            </StackPanel>
                        </ToggleButton>

                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <ToggleButton Focusable="False"
                                      x:Name="Step3Button"
                                      Style="{StaticResource StepButtonStyle}"
                                      Click="OnStep3Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="#E5E7EB"
                                        Margin="0,0,7,0">
                                    <TextBlock Text="3"
                                               Foreground="#4B5563"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Cleanup after split"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Delete unwanted split pieces"
                                               FontSize="10"
                                               Foreground="#7A8494" />
                                </StackPanel>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Split history:"
                                   Foreground="#697586"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <Button x:Name="AppliedHistoryColorButton"
                                Focusable="False"
                                Content="Color…"
                                Width="72"
                                Height="30"
                                Margin="0,0,6,0"
                                ToolTip="Choose the color used for applied split-history lines"
                                Click="OnAppliedHistoryColorClick" />
                        <TextBlock Text="Width"
                                   Foreground="#697586"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <ComboBox x:Name="AppliedHistoryWidthComboBox"
                                  Width="58"
                                  Height="30"
                                  Margin="0,0,8,0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnAppliedHistoryWidthChanged"
                                  ToolTip="Thickness of previous split lines">
                            <ComboBoxItem Content="1 px" Tag="1" />
                            <ComboBoxItem Content="2 px" Tag="2" />
                            <ComboBoxItem Content="3 px" Tag="3" />
                            <ComboBoxItem Content="4 px" Tag="4" />
                            <ComboBoxItem Content="5 px" Tag="5" />
                            <ComboBoxItem Content="6 px" Tag="6" />
                        </ComboBox>

                        <CheckBox x:Name="ShowPreviousSplitsCheckBox"
                                  Content="Show previous splits"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Checked="OnShowPreviousSplitsChanged"
                                  Unchecked="OnShowPreviousSplitsChanged" />

                        <Button x:Name="UndoButton"
                                Focusable="False"
                                Content="↶ Undo"
                                Width="90"
                                Height="30"
                                ToolTip="Undo the most recent split-line edit, split, deletion, or simplify operation (Ctrl+Z)"
                                Click="OnUndoClick" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="Step1ActionsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Focusable="False"
                            Content="Clear selection"
                            Height="30"
                            MinWidth="105"
                            Margin="0,0,6,0"
                            Click="OnClearSelectionClick" />
                    <Button Grid.Column="1"
                            Focusable="False"
                            Content="Invert"
                            Height="30"
                            MinWidth="76"
                            Margin="0,0,6,0"
                            Click="OnInvertSelectionClick" />
                    <Button Grid.Column="2"
                            x:Name="Step1DeleteButton"
                            Focusable="False"
                            Content="Delete selected lines (0)"
                            Height="30"
                            MinWidth="150"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="OnDeleteSelectedClick" />
                    <ToggleButton Grid.Column="3"
                                  x:Name="Step1LassoButton"
                                  Focusable="False"
                                  Content="Lasso"
                                  Height="30"
                                  MinWidth="70"
                                  Margin="0,0,4,0"
                                  Checked="OnLassoModeChanged"
                                  Unchecked="OnLassoModeChanged" />
                    <ComboBox Grid.Column="4"
                              x:Name="Step1LassoActionComboBox"
                              Width="78"
                              Height="30"
                              SelectedIndex="0"
                              SelectionChanged="OnLassoActionChanged">
                        <ComboBoxItem Content="Add" Tag="Add" />
                        <ComboBoxItem Content="Remove" Tag="Remove" />
                    </ComboBox>
                    <Button Grid.Column="5"
                            Focusable="False"
                            Content="Simplify / smooth..."
                            Height="30"
                            MinWidth="135"
                            Margin="8,0,0,0"
                            Click="OnSimplifyOpenClick"
                            ToolTip="Preview and apply point reduction or optional curve smoothing." />
                    <TextBlock Grid.Column="6"
                               Text="Click toggles one line. Drag crosses lines. Ctrl+drag makes an additive lasso."
                               Foreground="#697586"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>

                <Grid x:Name="Step2ActionsPanel"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Focusable="False"
                            Content="↓ Import split line..."
                            Height="30"
                            MinWidth="142"
                            Margin="0,0,6,0"
                            Click="OnImportSplitLineClick" />

                    <Button Grid.Column="1"
                            Focusable="False"
                            Content="✎ Draw split line"
                            Height="30"
                            MinWidth="130"
                            Margin="0,0,6,0"
                            Click="OnDrawSplitLineClick"
                            ToolTip="Draw another split path. Enter or double-click finishes the drawing; only Apply split performs the split." />

                    <Button Grid.Column="2"
                            Focusable="False"
                            x:Name="UseSelectedLineButton"
                            Content="Use selected line"
                            Height="30"
                            MinWidth="132"
                            Margin="0,0,6,0"
                            Click="OnUseSelectedAsSplitLineClick" />

                    <Button Grid.Column="3"
                            x:Name="RemovePendingSplitLineButton"
                            Focusable="False"
                            Content="✕ Remove pending line(s)"
                            Height="30"
                            MinWidth="130"
                            Margin="0,0,10,0"
                            IsEnabled="False"
                            Click="OnRemovePendingSplitLineClick" />

                    <Border Grid.Column="4"
                            Background="#F3EAFB"
                            CornerRadius="12"
                            Padding="9,4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="SplitLineSummaryText"
                                   Text="No split line yet"
                                   Foreground="#6E3CA6"
                                   FontSize="11" />
                    </Border>

                    <Border Grid.Column="5"
                            Background="#FFF3E8"
                            CornerRadius="12"
                            Padding="9,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="SplitPreviewSummaryText"
                                   Text="draw or import a split line"
                                   Foreground="#9A4F00"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>

                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="OnlySplitSelectedCheckBox"
                                  Content="Only split the selected lines"
                                  VerticalAlignment="Center"
                                  Checked="OnOnlySplitSelectedChanged"
                                  Unchecked="OnOnlySplitSelectedChanged" />
                        <TextBlock x:Name="SelectedSplitScopeText"
                                   Text="(none selected)"
                                   Foreground="#7A8494"
                                   FontSize="11"
                                   Margin="5,1,0,0"
                                   MaxWidth="340"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="7"
                            Focusable="False"
                            x:Name="ApplySplitButton"
                            Content="⚒ Apply split"
                            Height="32"
                            MinWidth="132"
                            Background="#2F6FCC"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="OnApplySplitClick"
                            ToolTip="Apply all pending split lines. Finishing a drawing does not apply it." />
                </Grid>

                <Grid x:Name="Step3ActionsPanel"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Focusable="False"
                            Content="Clear selection"
                            Height="30"
                            MinWidth="105"
                            Margin="0,0,6,0"
                            Click="OnClearSelectionClick" />
                    <Button Grid.Column="1"
                            Focusable="False"
                            Content="Invert"
                            Height="30"
                            MinWidth="76"
                            Margin="0,0,6,0"
                            Click="OnInvertSelectionClick" />
                    <Button Grid.Column="2"
                            x:Name="Step3DeleteButton"
                            Focusable="False"
                            Content="Delete selected pieces (0)"
                            Height="30"
                            MinWidth="160"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="OnDeleteSelectedClick" />
                    <ToggleButton Grid.Column="3"
                                  x:Name="Step3LassoButton"
                                  Focusable="False"
                                  Content="Lasso"
                                  Height="30"
                                  MinWidth="70"
                                  Margin="0,0,4,0"
                                  Checked="OnLassoModeChanged"
                                  Unchecked="OnLassoModeChanged" />
                    <ComboBox Grid.Column="4"
                              x:Name="Step3LassoActionComboBox"
                              Width="78"
                              Height="30"
                              SelectedIndex="0"
                              SelectionChanged="OnLassoActionChanged">
                        <ComboBoxItem Content="Add" Tag="Add" />
                        <ComboBoxItem Content="Remove" Tag="Remove" />
                    </ComboBox>
                    <Button Grid.Column="5"
                            Focusable="False"
                            Content="Simplify / smooth..."
                            Height="30"
                            MinWidth="135"
                            Margin="8,0,0,0"
                            Click="OnSimplifyOpenClick"
                            ToolTip="Preview and apply point reduction or optional curve smoothing." />
                    <TextBlock Grid.Column="6"
                               Text="Click toggles pieces; lasso can add or remove a group."
                               Foreground="#697586"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>

                <Border x:Name="SimplifyPanel"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        Padding="10,8"
                        Background="#F7F9FC"
                        BorderBrush="#D5DCE6"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Simplify:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="SimplifyToleranceComboBox"
                                      Width="82"
                                      Height="28"
                                      IsEditable="True"
                                      SelectedIndex="2"
                                      SelectionChanged="OnSimplifySettingsChanged"
                                      KeyUp="OnSimplifyToleranceKeyUp"
                                      ToolTip="Choose a preset tolerance in metres, or type a custom value.">
                                <ComboBoxItem Content="Off" />
                                <ComboBoxItem Content="0.5" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="10" />
                            </ComboBox>
                            <TextBlock Text="m"
                                       VerticalAlignment="Center"
                                       Margin="4,0,10,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="6,0,12,0"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="SimplifySmoothCheckBox"
                                      Content="Smooth curves"
                                      Checked="OnSimplifySettingsChanged"
                                      Unchecked="OnSimplifySettingsChanged" />
                            <TextBlock x:Name="SimplifySmoothWarningText"
                                       Text="Smoothing without simplifying may add points and changes the geometry."
                                       Visibility="Collapsed"
                                       Foreground="#A15C00"
                                       FontSize="10"
                                       MaxWidth="290"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Apply to:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <RadioButton x:Name="SimplifyAllRadioButton"
                                         GroupName="SimplifyScope"
                                         Content="All lines"
                                         IsChecked="True"
                                         Checked="OnSimplifySettingsChanged"
                                         Margin="0,0,8,0" />
                            <RadioButton x:Name="SimplifySelectedRadioButton"
                                         GroupName="SimplifyScope"
                                         Content="Only selected lines (0)"
                                         Checked="OnSimplifySettingsChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="SimplifySummaryText"
                                       Text="Preview not calculated."
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       MaxWidth="300"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SimplifyWarningText"
                                       Text=""
                                       FontSize="10"
                                       Foreground="#B42318"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="4"
                                   Text="Preview shows the proposed geometry; nothing changes until Apply."
                                   Foreground="#697586"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,12,0" />

                        <Button Grid.Column="5"
                                Focusable="False"
                                Content="Cancel preview"
                                Height="30"
                                MinWidth="108"
                                Margin="0,0,6,0"
                                Click="OnSimplifyCancelClick" />

                        <Button Grid.Column="6"
                                x:Name="ApplySimplifyButton"
                                Focusable="False"
                                Content="Apply"
                                Height="30"
                                MinWidth="86"
                                IsEnabled="False"
                                Background="#2F6FCC"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="OnSimplifyApplyClick" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#F8FAFC"
                BorderBrush="#D9DEE7"
                BorderThickness="0,1,0,0"
                Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StatusText"
                               FontWeight="SemiBold"
                               Foreground="#263244"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ScopeText"
                               Foreground="#697586"
                               FontSize="11"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Changes return to the main window; use Save As there to write the file."
                               Foreground="#7A8494"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Button Focusable="False"
                            Content="Cancel — discard"
                            Width="120"
                            Height="32"
                            Click="OnCancelClick" />
                    <Button Focusable="False"
                            Content="Done — keep changes"
                            Width="145"
                            Height="32"
                            Margin="8,0,0,0"
                            Background="#2F6FCC"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="OnApplyClick"
                            ToolTip="Keep geometry edits in the loaded working document. Save As writes them to disk." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Margin="12"
                BorderBrush="#C8CCD2"
                BorderThickness="1"
                CornerRadius="5"
                Background="White">
            <Grid>
                <views:LineEditorSurface x:Name="EditorSurface" />

                <Border x:Name="MapInstructionPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="10,8"
                        Background="#F2FFFFFF"
                        BorderBrush="#D0D6DE"
                        BorderThickness="1"
                        CornerRadius="4"
                        MaxWidth="470">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="InstructionText"
                                       FontWeight="SemiBold"
                                       Foreground="#243B64"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ToolHintText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#4B5563"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Focusable="False"
                                Content="×"
                                Width="22"
                                Height="22"
                                Padding="0"
                                Margin="10,-3,-3,0"
                                VerticalAlignment="Top"
                                ToolTip="Hide instructions"
                                Click="OnHideMapInstructionsClick" />
                    </Grid>
                </Border>

                <Button x:Name="MapInstructionShowButton"
                        Focusable="False"
                        Content="? Tips"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="8,4"
                        Visibility="Collapsed"
                        ToolTip="Show line editor instructions"
                        Click="OnShowMapInstructionsClick" />

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="12"
                        Padding="9,6"
                        Background="#F2FFFFFF"
                        BorderBrush="#D0D6DE"
                        BorderThickness="1"
                        CornerRadius="4"
                        IsHitTestVisible="False">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Rectangle Width="22" Height="2" Fill="#545C66" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Line" FontSize="11" Foreground="#52606D" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Rectangle Width="22" Height="3" Fill="#BE2D2D" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Selected (for deleting)" FontSize="11" Foreground="#52606D" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Rectangle Width="22"
                                       Height="3"
                                       Fill="Transparent"
                                       Stroke="#743DAA"
                                       StrokeThickness="2"
                                       StrokeDashArray="3,2"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <TextBlock Text="Pending split line" FontSize="11" Foreground="#52606D" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Rectangle x:Name="AppliedHistoryLegendLine"
                                       Width="22"
                                       Height="2"
                                       Fill="#8E84A8"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <TextBlock Text="Previous split" FontSize="11" Foreground="#52606D" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Ellipse Width="8" Height="8" Fill="#DA5E27" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Split point" FontSize="11" Foreground="#52606D" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#707078" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Previous split point" FontSize="11" Foreground="#52606D" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="12">
                    <Button Focusable="False"
                            Content="+  Zoom in"
                            Width="112"
                            Height="29"
                            Click="OnZoomInClick" />
                    <Button Focusable="False"
                            Content="−  Zoom out"
                            Width="112"
                            Height="29"
                            Margin="0,4,0,0"
                            Click="OnZoomOutClick" />
                    <Button Focusable="False"
                            Content="↗ Fit"
                            Width="112"
                            Height="29"
                            Margin="0,4,0,0"
                            Click="OnFitViewClick" />
                    <Button Focusable="False"
                            Content="To selection"
                            Width="112"
                            Height="29"
                            Margin="0,4,0,0"
                            Click="OnZoomSelectionClick" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
