<Window x:Class="KmlScopedEditor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Simple KML Editor"
        Icon="{StaticResource AppIcon}"
        Width="540"
        Height="500"
        MinWidth="540"
        MinHeight="500"
        MaxWidth="540"
        MaxHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FC"
        ShowInTaskbar="False">
    <Border Margin="18"
            Padding="24"
            Background="White"
            BorderBrush="#D9E0E9"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Width="122"
                    Height="122"
                    CornerRadius="22"
                    Background="#F3F8FD"
                    Padding="12"
                    HorizontalAlignment="Center">
                <Image Source="{StaticResource AppIcon}"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center">
                <TextBlock Text="Simple KML Editor"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#173B6D"
                           HorizontalAlignment="Center" />

                <TextBlock x:Name="VersionText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#64748B"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="18,18,18,0">
                <TextBlock Text="Edit, split, simplify and style KML/KMZ files."
                           FontSize="14"
                           Foreground="#334155"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock Text="A focused desktop editor for working with KML and KMZ geometry, placemark styles and line-based map data without needing a full GIS application."
                           Margin="0,10,0,0"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="#64748B"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Margin="24,20,24,0"
                        VerticalAlignment="Top">
                <Separator Margin="0,0,0,14" />

                <TextBlock FontSize="12"
                           Foreground="#334155"
                           Margin="0,0,0,8"
                           TextAlignment="Center">
                    <Run FontWeight="SemiBold"
                         Text="Developer: " />
                    <Run Text="Arif Shaon" />
                </TextBlock>

                <TextBlock FontSize="12"
                           Foreground="#334155"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <Run FontWeight="SemiBold"
                         Text="Project repository: " />
                    <Hyperlink NavigateUri="https://github.com/arifshaon/kmlbatcheditor"
                               ToolTip="Open the Simple KML Editor GitHub repository."
                               RequestNavigate="OnGitHubLinkClick">
                        github.com/arifshaon/kmlbatcheditor
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="© 2026 Arif Shaon"
                           Margin="0,16,0,0"
                           FontSize="11"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Button Grid.Row="4"
                    Content="Close"
                    Width="90"
                    Height="32"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    ToolTip="Close this About window."
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
