<Window x:Class="KmlScopedEditor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Simple KML Editor"
        Icon="{StaticResource AppIcon}"
        Width="520"
        Height="430"
        MinWidth="520"
        MinHeight="430"
        MaxWidth="520"
        MaxHeight="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FC"
        ShowInTaskbar="False">
    <Border Margin="18"
            Padding="24"
            Background="White"
            BorderBrush="#D9E0E9"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center">
                <Border Width="122"
                        Height="122"
                        CornerRadius="22"
                        Background="#F3F8FD"
                        Padding="12">
                    <Image Source="{StaticResource AppIcon}"
                           Stretch="Uniform" />
                </Border>

                <TextBlock Text="Simple KML Editor"
                           Margin="0,16,0,2"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#173B6D"
                           HorizontalAlignment="Center" />

                <TextBlock x:Name="VersionText"
                           FontSize="12"
                           Foreground="#64748B"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Edit, split, simplify and style KML/KMZ files."
                           Margin="0,16,0,0"
                           FontSize="14"
                           Foreground="#334155"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock Text="A focused desktop editor for working with KML and KMZ geometry, placemark styles and line-based map data without needing a full GIS application."
                           Margin="22,8,22,0"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="#64748B"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Separator Margin="24,18,24,12" />

                <TextBlock Text="© 2026 Arif Shaon"
                           FontSize="11"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Button Grid.Row="1"
                    Content="Close"
                    Width="90"
                    Height="32"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    ToolTip="Close this About window."
                    Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
