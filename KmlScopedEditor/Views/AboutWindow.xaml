<Window x:Class="KmlScopedEditor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Simple KML Editor"
        Icon="{StaticResource AppIcon}"
        Width="540"
        Height="560"
        MinWidth="540"
        MinHeight="560"
        MaxWidth="540"
        MaxHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FC"
        ShowInTaskbar="False">
    <Border Margin="18"
            Background="White"
            BorderBrush="#D9E0E9"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,24,24,12">
                <StackPanel>
                    <Border Width="122"
                            Height="122"
                            CornerRadius="22"
                            Background="#F3F8FD"
                            Padding="12"
                            HorizontalAlignment="Center">
                        <Image Source="{StaticResource AppIcon}"
                               Stretch="Uniform" />
                    </Border>

                    <TextBlock Text="Simple KML Editor"
                               Margin="0,16,0,0"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#173B6D"
                               HorizontalAlignment="Center" />

                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#64748B"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Edit, split, simplify and style KML/KMZ files."
                               Margin="18,18,18,0"
                               FontSize="14"
                               Foreground="#334155"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <TextBlock Text="A focused desktop editor for working with KML and KMZ geometry, placemark styles and line-based map data without needing a full GIS application."
                               Margin="18,10,18,0"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="#64748B"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <Separator Margin="24,20,24,14" />

                    <TextBlock FontSize="13"
                               Foreground="#173B6D"
                               Margin="0,0,0,10"
                               TextAlignment="Center"
                               HorizontalAlignment="Center">
                        <Run Text="Developed by " />
                        <Run FontWeight="SemiBold"
                             Text="Arif Shaon" />
                    </TextBlock>

                    <TextBlock FontSize="12"
                               Foreground="#334155"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <Run FontWeight="SemiBold"
                             Text="Project repository: " />
                        <Hyperlink NavigateUri="https://github.com/arifshaon/kmlbatcheditor"
                                   ToolTip="Open the Simple KML Editor GitHub repository."
                                   RequestNavigate="OnGitHubLinkClick">
                            github.com/arifshaon/kmlbatcheditor
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="© 2026 Arif Shaon"
                               Margin="0,16,0,6"
                               FontSize="11"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Background="#FAFBFD"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Button Content="Close"
                        Width="96"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsDefault="True"
                        IsCancel="True"
                        ToolTip="Close this About window."
                        Click="OnCloseClick" />
            </Border>
        </Grid>
    </Border>
</Window>
