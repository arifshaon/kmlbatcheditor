<Window x:Class="KmlScopedEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KmlScopedEditor.ViewModels"
        xmlns:models="clr-namespace:KmlScopedEditor.Models"
        xmlns:views="clr-namespace:KmlScopedEditor.Views"
        mc:Ignorable="d"
        Title="Simple KML Editor"
        Icon="/KmlScopedEditor;component/Assets/simple_kml_editor.ico"
        Height="820"
        Width="1380"
        MinHeight="680"
        MinWidth="1080">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#E8F0FE" />
                    <Setter Property="BorderBrush" Value="#6A9FE8" />
                    <Setter Property="Foreground" Value="#174EA6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepNumberStyle" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#2F6FCC" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <HierarchicalDataTemplate
            DataType="{x:Type models:KmlTreeNode}"
            ItemsSource="{Binding Children}">
            <Grid Margin="2,2,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsThreeState="False"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Top"
                          Margin="0,2,7,0"
                          ToolTip="Tick this item to include its placemarks in Ticked items mode" />

                <TextBlock Grid.Column="1"
                           Margin="0,1,6,0"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="📄" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeType}" Value="Folder">
                                    <Setter Property="Text" Value="📁" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeType}" Value="Document">
                                    <Setter Property="Text" Value="🗂" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeType}" Value="Placemark">
                                    <Setter Property="Text" Value="📍" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeType}" Value="GroundOverlay">
                                    <Setter Property="Text" Value="▧" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeType}" Value="NetworkLink">
                                    <Setter Property="Text" Value="🔗" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               Foreground="#1F3A93"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11"
                               Foreground="#7A8494"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="520" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel IsEnabled="{Binding IsNotBusy}">
            <Border DockPanel.Dock="Top"
                    Background="White"
                    BorderBrush="#D9DEE7"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="📂 Open..."
                                Width="92"
                                Height="32"
                                Command="{Binding OpenKmlCommand}" />
                        <Button Content="💾 Save As..."
                                Width="110"
                                Height="32"
                                Margin="8,0,0,0"
                                Command="{Binding SaveAsCommand}" />
                        <Button Content="✎ Edit Lines..."
                                Width="116"
                                Height="32"
                                Margin="14,0,0,0"
                                IsEnabled="{Binding HasLoadedDocument}"
                                Click="OnLineEditorClick"
                                ToolTip="Open the line editor for the whole loaded file." />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Margin="18,7,12,0"
                               Text="{Binding LoadedFilePath}"
                               Foreground="#697586"
                               TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="2"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#FFF0F0"
                            CornerRadius="14"
                            Padding="10,5"
                            VerticalAlignment="Center">
                        <TextBlock Text="● Unsaved changes"
                                   Foreground="#B42318"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top"
                    Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#EEF5FF"
                    BorderBrush="#BFD2EF"
                    BorderThickness="0,0,0,1"
                    Padding="10,7">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Command="{Binding DismissNotificationCommand}"
                            Width="26"
                            Height="22"
                            Margin="10,0,0,0" />
                    <TextBlock Text="{Binding NotificationText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <StatusBar DockPanel.Dock="Bottom"
                       Background="#F8FAFC"
                       BorderBrush="#D9DEE7"
                       BorderThickness="0,1,0,0">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#64748B" />
                </StatusBarItem>
            </StatusBar>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#FAFBFD"
                        BorderBrush="#D9DEE7"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="14,12,14,8"
                                   Text="Tick items to target them; click a row to inspect it or use it as the Tree item scope."
                                   Foreground="#52606D"
                                   TextWrapping="Wrap" />

                        <TreeView ItemsSource="{Binding RootNodes}"
                                  Margin="0,0,0,8"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected"
                                            Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="3,2" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#EEF1F5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />

                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Style changes"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#263244"
                                   Margin="0,0,0,10" />

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource StepNumberStyle}">
                                        <TextBlock Text="1"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Which placemarks?"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,10">
                                    <ToggleButton Style="{StaticResource ModeButtonStyle}"
                                                  Content="Tree item"
                                                  IsChecked="{Binding IsFolderSelectionMode, Mode=OneWay}"
                                                  Command="{Binding SetSelectionModeCommand}"
                                                  CommandParameter="Folder" />
                                    <ToggleButton Style="{StaticResource ModeButtonStyle}"
                                                  Content="Ticked"
                                                  IsChecked="{Binding IsTickedSelectionMode, Mode=OneWay}"
                                                  Command="{Binding SetSelectionModeCommand}"
                                                  CommandParameter="Ticked" />
                                    <ToggleButton Style="{StaticResource ModeButtonStyle}"
                                                  Content="Placemark name"
                                                  IsChecked="{Binding IsPlacemarkNameSelectionMode, Mode=OneWay}"
                                                  Command="{Binding SetSelectionModeCommand}"
                                                  CommandParameter="PlacemarkName" />
                                    <ToggleButton Style="{StaticResource ModeButtonStyle}"
                                                  Content="Icon image"
                                                  IsChecked="{Binding IsIconImageSelectionMode, Mode=OneWay}"
                                                  Command="{Binding SetSelectionModeCommand}"
                                                  CommandParameter="IconImage" />
                                    <ToggleButton Style="{StaticResource ModeButtonStyle}"
                                                  Content="Icon variant"
                                                  IsChecked="{Binding IsIconVariantSelectionMode, Mode=OneWay}"
                                                  Command="{Binding SetSelectionModeCommand}"
                                                  CommandParameter="IconVariant" />
                                </WrapPanel>

                                <StackPanel Visibility="{Binding IsFolderSelectionMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="0,0,0,10">
                                    <WrapPanel>
                                        <TextBlock Text="Tree item: "
                                                   Foreground="#52606D"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedNode.Name}"
                                                   Foreground="#1F3A93"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <CheckBox Content="Include sub-folders"
                                                  IsChecked="{Binding IncludeSubfolders}"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsTickedSelectionMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="0,0,0,10">
                                    <WrapPanel>
                                        <Button Content="Tick all"
                                                Command="{Binding TickAllCommand}"
                                                MinWidth="76"
                                                Height="28"
                                                Margin="0,0,6,0" />
                                        <Button Content="Untick all"
                                                Command="{Binding UntickAllCommand}"
                                                MinWidth="86"
                                                Height="28"
                                                Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding SelectionSummary}"
                                                   Foreground="#52606D"
                                                   VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>

                                <views:PlacemarkNameSelectionControl />

                                <StackPanel Visibility="{Binding IsIconTypeSelectionMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="{Binding IconSelectionPrompt}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <ListBox ItemsSource="{Binding IconTypes}"
                                             Height="160"
                                             HorizontalContentAlignment="Stretch"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Padding="4"
                                                          ToolTip="{Binding IconHref}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   Foreground="#697586"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Border Background="#ECF8F0"
                                        BorderBrush="#A8D5B6"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓ "
                                                   Foreground="#18733B"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding MatchedPlacemarkCount, StringFormat={}{0:N0} placemarks will change}"
                                                   Foreground="#18733B"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding SelectionSummary}"
                                           Foreground="#697586"
                                           FontSize="11"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource StepNumberStyle}">
                                        <TextBlock Text="2"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="What to change?"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Expander IsExpanded="True"
                                          Margin="0,0,0,6">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Lines"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text=" — "
                                                       Foreground="#7A8494"
                                                       Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding LineGroupSummary}"
                                                       Foreground="#7A8494" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <Grid Margin="18,8,0,10"
                                          IsEnabled="{Binding HasSelectedLines}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <CheckBox Grid.Row="0" Grid.Column="0"
                                                  Content="Line colour"
                                                  IsChecked="{Binding EditSettings.ChangeLineColor}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding EditSettings.LineColorText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeLineColor}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />
                                        <Button Grid.Row="0" Grid.Column="2"
                                                Content="Choose..."
                                                Command="{Binding PickLineColorCommand}"
                                                IsEnabled="{Binding EditSettings.ChangeLineColor}"
                                                MinWidth="82"
                                                Margin="0,2,0,2" />

                                        <CheckBox Grid.Row="1" Grid.Column="0"
                                                  Content="Line width"
                                                  IsChecked="{Binding EditSettings.ChangeLineWidth}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding EditSettings.LineWidthText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeLineWidth}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />

                                        <CheckBox Grid.Row="2" Grid.Column="0"
                                                  Content="Line opacity"
                                                  IsChecked="{Binding EditSettings.ChangeLineOpacity}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding EditSettings.LineOpacityText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeLineOpacity}"
                                                 Margin="0,2,6,2"
                                                 Padding="5"
                                                 ToolTip="0 to 100 percent" />
                                        <TextBlock Grid.Row="2" Grid.Column="2"
                                                   Text="%"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Expander>

                                <Separator Margin="0,2,0,4" />

                                <Expander IsExpanded="False"
                                          Margin="0,0,0,6">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Icons"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text=" — "
                                                       Foreground="#7A8494"
                                                       Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding IconGroupSummary}"
                                                       Foreground="#7A8494" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <Grid Margin="18,8,0,10"
                                          IsEnabled="{Binding HasSelectedIcons}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <CheckBox Grid.Row="0" Grid.Column="0"
                                                  Content="Icon image"
                                                  IsChecked="{Binding EditSettings.ChangeIconImage}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding EditSettings.IconFileNameDisplay}"
                                                 IsReadOnly="True"
                                                 IsEnabled="{Binding EditSettings.ChangeIconImage}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />
                                        <Button Grid.Row="0" Grid.Column="2"
                                                Content="Browse..."
                                                Command="{Binding BrowseIconFileCommand}"
                                                MinWidth="82"
                                                Margin="0,2,0,2" />

                                        <CheckBox Grid.Row="1" Grid.Column="0"
                                                  Content="Icon size"
                                                  IsChecked="{Binding EditSettings.ChangeIconScale}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding EditSettings.IconScaleText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeIconScale}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />

                                        <CheckBox Grid.Row="2" Grid.Column="0"
                                                  Content="Icon colour"
                                                  IsChecked="{Binding EditSettings.ChangeIconColor}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding EditSettings.IconColorText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeIconColor}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />
                                        <Button Grid.Row="2" Grid.Column="2"
                                                Content="Choose..."
                                                Command="{Binding PickIconColorCommand}"
                                                IsEnabled="{Binding EditSettings.ChangeIconColor}"
                                                MinWidth="82"
                                                Margin="0,2,0,2" />

                                        <CheckBox Grid.Row="3" Grid.Column="0"
                                                  Content="Icon opacity"
                                                  IsChecked="{Binding EditSettings.ChangeIconOpacity}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding EditSettings.IconOpacityText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeIconOpacity}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />
                                        <TextBlock Grid.Row="3" Grid.Column="2"
                                                   Text="%"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Expander>

                                <Separator Margin="0,2,0,4" />

                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Labels (text)"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text=" — "
                                                       Foreground="#7A8494"
                                                       Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding LabelGroupSummary}"
                                                       Foreground="#7A8494" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <Grid Margin="18,8,0,10"
                                          IsEnabled="{Binding HasSelectedLabels}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <CheckBox Grid.Row="0" Grid.Column="0"
                                                  Content="Text size"
                                                  IsChecked="{Binding EditSettings.ChangeLabelScale}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding EditSettings.LabelScaleText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeLabelScale}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />

                                        <CheckBox Grid.Row="1" Grid.Column="0"
                                                  Content="Text colour"
                                                  IsChecked="{Binding EditSettings.ChangeLabelColor}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding EditSettings.LabelColorText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeLabelColor}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />
                                        <Button Grid.Row="1" Grid.Column="2"
                                                Content="Choose..."
                                                Command="{Binding PickLabelColorCommand}"
                                                IsEnabled="{Binding EditSettings.ChangeLabelColor}"
                                                MinWidth="82"
                                                Margin="0,2,0,2" />

                                        <CheckBox Grid.Row="2" Grid.Column="0"
                                                  Content="Text opacity"
                                                  IsChecked="{Binding EditSettings.ChangeLabelOpacity}"
                                                  Margin="0,5,8,5" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding EditSettings.LabelOpacityText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EditSettings.ChangeLabelOpacity}"
                                                 Margin="0,2,6,2"
                                                 Padding="5" />
                                        <TextBlock Grid.Row="2" Grid.Column="2"
                                                   Text="%"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource StepNumberStyle}">
                                        <TextBlock Text="3"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Preview"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <views:PlacemarkPreviewControl />

                                <TextBlock Text="{Binding BatchEditMessage}"
                                           Foreground="#52606D"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Style="{StaticResource StepNumberStyle}">
                                        <TextBlock Text="4"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Apply"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding ApplyStyleButtonText}"
                                        Command="{Binding ApplyChangesCommand}"
                                        Background="#2F6FCC"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Padding="16,7"
                                        Margin="16,0,12,0"
                                        MinWidth="150" />

                                <TextBlock Grid.Column="2"
                                           Text="Your original file is not changed until you use Save As."
                                           Foreground="#697586"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Expander Header="Inspect selected item (style diagnostics)"
                                  IsExpanded="False"
                                  Margin="0,0,0,18">
                            <Border Margin="0,8,0,0"
                                    Padding="12"
                                    Background="#FCFCFC"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Style source:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedStyle.StyleSource}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="styleUrl:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStyle.StyleUrlDisplay}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Normal style:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStyle.NormalStyleUrlDisplay}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Highlight style:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedStyle.HighlightStyleUrlDisplay}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Inline style:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedStyle.InlineStyleDisplay}" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Icon URL:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedStyle.IconHrefDisplay}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Icon size:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedStyle.IconScaleDisplay}" Margin="0,3" />
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Icon colour:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedStyle.IconColorDisplay}" Margin="0,3" />
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Text size:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedStyle.LabelScaleDisplay}" Margin="0,3" />
                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Text colour:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedStyle.LabelColorDisplay}" Margin="0,3" />
                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Line colour:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedStyle.LineColorDisplay}" Margin="0,3" />
                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Line width:" FontWeight="SemiBold" Margin="0,3" />
                                    <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedStyle.LineWidthDisplay}" Margin="0,3" />
                                </Grid>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <Border Panel.ZIndex="100"
                Background="#99000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Border Width="500"
                        MaxWidth="700"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#C8CDD5"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyTitle}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <ProgressBar Height="18"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding BusyProgress,
                                                     Mode=OneWay,
                                                     FallbackValue=0,
                                                     TargetNullValue=0}"
                                     IsIndeterminate="{Binding IsBusyProgressIndeterminate}"
                                     Margin="0,0,0,10" />
                        <TextBlock Text="{Binding BusyDetail}"
                                   Foreground="#5E6673"
                                   TextWrapping="Wrap"
                                   MinHeight="18"
                                   Margin="0,0,0,16" />
                        <Button Content="Cancel"
                                Command="{Binding CancelOperationCommand}"
                                Visibility="{Binding CanCancelCurrentOperation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Width="100"
                                Height="32"
                                HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
