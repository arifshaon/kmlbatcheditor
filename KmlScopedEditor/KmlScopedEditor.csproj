<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <Product>Simple KML Editor</Product>
    <AssemblyTitle>Simple KML Editor</AssemblyTitle>
    <Authors>Arif Shaon</Authors>
    <Description>Windows desktop application for editing KML and KMZ placemark styles and line geometry, with preview, splitting, simplification, smoothing, and scoped batch editing.</Description>
  </PropertyGroup>

  <!-- Ship the current noncommercial license and required notice with
       portable ZIPs and installed Windows builds. -->
  <ItemGroup>
    <None Include="..\LICENSE"
          Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
    <None Include="..\NOTICE"
          Link="NOTICE"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
